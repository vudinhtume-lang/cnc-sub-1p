rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "Iy2xpQNDfGS5LYdM15shqELoGWz2";
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }
function hasActiveProfile() {
  return isActiveUser();
}
    function validTaskStatus() {
  return request.resource.data.status in ['todo', 'in_progress', 'done'];
}

function canAssignTaskTo(assigneeId) {
  return isActiveUser()
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.role == 'MANAGER'
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.get('canAssignTasks', true) != false
    && exists(
      /databases/$(database)/documents/users/$(assigneeId)
    )
    && get(
      /databases/$(database)/documents/users/$(assigneeId)
    ).data.status == 'ACTIVE'
    && (
      get(
        /databases/$(database)/documents/users/$(assigneeId)
      ).data.get('managerUid', '') == request.auth.uid
      ||
      request.auth.uid in get(
        /databases/$(database)/documents/users/$(assigneeId)
      ).data.get('managerUids', [])
    );
}

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin()
  || (
    signedIn()
    && (
      resource.data.managerUid == request.auth.uid
      || (
        'managerUids' in resource.data
        && request.auth.uid in resource.data.managerUids
      )
    )
  );

      allow create, update: if isAdmin()
        && (
          request.resource.data.role != 'ADMIN'
          || userId == "Iy2xpQNDfGS5LYdM15shqELoGWz2"
        );

      allow delete: if isAdmin()
        && userId != "Iy2xpQNDfGS5LYdM15shqELoGWz2";
    }

 match /tasks/{taskId} {
  allow read: if isActiveUser();

  // Tạo task: Admin hoặc Manager giao đúng phạm vi
  allow create: if isAdmin()
    || (
      canAssignTaskTo(request.resource.data.assigneeId)
      && request.resource.data.createdBy == request.auth.uid
    );

  // Xóa task: Admin hoặc chính Manager đã tạo
  allow delete: if isAdmin()
    || (
      isActiveUser()
      && resource.data.createdBy == request.auth.uid
      && get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role == 'MANAGER'
    );

  // Sửa task: Admin, Manager tạo task hoặc nhân viên cập nhật trạng thái
    allow update: if isAdmin()
    || (
      canAssignTaskTo(request.resource.data.assigneeId)
      && resource.data.createdBy == request.auth.uid
      && request.resource.data.createdBy == resource.data.createdBy
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'title',
          'assigneeId',
          'assigneeName',
          'priority',
          'deadline',
          'desc',
          'updateVersion',
          'updateChanges',
          'updateAcknowledged',
          'updateAcknowledgedAt',
          'updateAcknowledgedBy',
          'updateBy',
          'updateAt'
        ])
    )
    || (
      isActiveUser()
      && resource.data.assigneeId == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'status',
          'acknowledged',
          'acknowledgedAt',
          'updateAcknowledged',
          'updateAcknowledgedAt',
          'updateAcknowledgedBy'
        ])
      && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status'])
        || validTaskStatus()
      )
      && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['acknowledged'])
        || request.resource.data.acknowledged == true
      )
      && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'updateAcknowledged',
            'updateAcknowledgedAt',
            'updateAcknowledgedBy'
          ])
        || (
          request.resource.data.updateAcknowledged == true
          && request.resource.data.updateAcknowledgedBy == request.auth.uid
          && request.resource.data.updateAcknowledgedAt is string
        )
      )
    );
}

match /task_history/{historyId} {

  function canAccessTask(taskId) {
    return exists(
      /databases/$(database)/documents/tasks/$(taskId)
    ) && (
      isAdmin()
      || get(
        /databases/$(database)/documents/tasks/$(taskId)
      ).data.assigneeId == request.auth.uid
      || get(
        /databases/$(database)/documents/tasks/$(taskId)
      ).data.createdBy == request.auth.uid
      || (
        exists(
          /databases/$(database)/documents/users/$(
            get(
              /databases/$(database)/documents/tasks/$(taskId)
            ).data.assigneeId
          )
        )
                && (
          get(
            /databases/$(database)/documents/users/$(
              get(
                /databases/$(database)/documents/tasks/$(taskId)
              ).data.assigneeId
            )
          ).data.get('managerUid', '') == request.auth.uid
          ||
          request.auth.uid in get(
            /databases/$(database)/documents/users/$(
              get(
                /databases/$(database)/documents/tasks/$(taskId)
              ).data.assigneeId
            )
          ).data.get('managerUids', [])
        )
        ));
  }

  allow read: if isAdmin()
    || (
      hasActiveProfile()
      && canAccessTask(resource.data.taskId)
    );

  allow create: if hasActiveProfile()
    && request.resource.data.keys().hasOnly([
      'taskId',
      'taskTitle',
      'action',
      'details',
      'actorUid',
      'actorName',
      'createdAt'
    ])
    && request.resource.data.actorUid == request.auth.uid
    && request.resource.data.taskId is string
    && request.resource.data.action in [
      'CREATE',
      'UPDATE',
      'STATUS_CHANGE',
      'ACKNOWLEDGE'
    ]
    && canAccessTask(request.resource.data.taskId);

  allow update, delete: if false;
}
    // SMART NOTIFICATION: mỗi tài khoản chỉ quản lý thông báo của mình
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isActiveUser()
        && request.auth.uid == userId;

      allow create: if isActiveUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'type',
          'title',
          'body',
          'taskId',
          'createdAt',
          'read'
        ])
        && request.resource.data.keys().hasOnly([
          'type',
          'title',
          'body',
          'taskId',
          'createdAt',
          'read'
        ])
        && request.resource.data.type in [
          'new_task',
          'due_soon',
          'overdue',
          'completed',
          'important_update'
        ]
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.taskId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.read == false;

      allow update: if isActiveUser()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
